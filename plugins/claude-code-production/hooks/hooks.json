{
  "hooks": {
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/protect-paths.sh" },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scan-secrets.sh" }
        ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/format.sh" }
        ] }
    ]
  }
}
